{
  "$schema": "https://turborepo.dev/schema.json",
  "ui":"tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_*", "NODE_ENV"]
    },
    "test": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "lint": {
      "cache": false
    }
  }
}
