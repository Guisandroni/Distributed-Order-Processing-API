JWT_SECRET=


DATABASE_URL="postgresql://nestjsCrud:nestjsCrud@localhost:2020/nestjsCrud?schema=public"

# RabbitMQ reliability + Transactional Outbox (Fase 12)
# Attempts before DLQ (PRD-fixed); retry delay per attempt (fixed-5s v1)
MAX_RETRIES=3
RETRY_TTL_MS=5000
# Outbox publisher poll interval and batch size
OUTBOX_POLL_MS=5000
OUTBOX_BATCH_SIZE=20
