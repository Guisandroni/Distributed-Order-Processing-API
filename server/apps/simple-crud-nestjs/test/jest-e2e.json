{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../../..",
  "roots": ["<rootDir>/apps/simple-crud-nestjs/test"],
  "testEnvironment": "node",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@nestjs/schedule$": "<rootDir>/apps/simple-crud-nestjs/test/vendor/nestjs-schedule/index.js",
    "^@lib/prisma$": "<rootDir>/libs/prisma/src",
    "^@lib/prisma/(.*)$": "<rootDir>/libs/prisma/src/$1",
    "^@lib/contracts$": "<rootDir>/libs/contracts/src",
    "^@lib/contracts/(.*)$": "<rootDir>/libs/contracts/src/$1",
    "^generated/(.*)$": "<rootDir>/generated/$1",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
